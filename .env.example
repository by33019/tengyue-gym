# ============================================================
# 腾跃健身 - 环境变量配置
# 部署前复制为 .env 并修改所有密码/密钥
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=请修改为强密码
MYSQL_DATABASE=gym_checkin
MYSQL_USER=gym
MYSQL_PASSWORD=请修改为强密码

# Redis
REDIS_PASSWORD=请修改为强密码

# JWT（生产环境请生成随机密钥: openssl rand -base64 64）
JWT_SECRET=请修改为随机64位密钥
JWT_EXPIRATION=7200000
JWT_REFRESH_EXPIRATION=604800000

# MinIO 对象存储
MINIO_ACCESS_KEY=请修改为强账号
MINIO_SECRET_KEY=请修改为强密码（至少8位）
MINIO_BUCKET=gym-avatars

# Coze Agent（AI 功能）
COZE_API_URL=https://q9khtybwsw.coze.site/stream_run
COZE_API_TOKEN=你的-coze-api-token
COZE_PROJECT_ID=7640283069890609190
